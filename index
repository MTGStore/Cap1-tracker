<script>
const PASS_B64='OTc3Mzgx'; // btoa('977381')
const STORES=[
  {key:'KC9',      name:'KC9 - KC Mart 09',    ba:'KC9 6613'},
  {key:'SQS',      name:'SQS',                  ba:'SQS 3VD 5246'},
  {key:'HP',       name:'HP - Hickory Point',   ba:'HP 7578'},
  {key:'MTG3',     name:'MTG-3 (Vivek)',         ba:'TMG3 -9999'},
  {key:'MTG4',     name:'MTG-4 Charlotte',       ba:'MTG-4 - 0726'},
  {key:'MTG5',     name:'MTG-5 Rock Hill',       ba:'MTG-5- FS-0718'},
  {key:'MTG6',     name:'MTG-6 Gray Court',      ba:'mtg-6 ops 0988'},
  {key:'QSTOP',    name:'QuickStop',             ba:'QStop FCB 6877'},
  {key:'KNGPINAL', name:'KNG Pinal',             ba:'Pinal Naav 3744'},
  {key:'KC4',      name:'KC4 (VDANK)',           ba:'KC4 VDANK 2354'},
  {key:'MMLLC',    name:'MMLLC / Liq Store',     ba:'MMLLC main 2187'},
  {key:'PATS2',    name:"Pat's 2",               ba:'MMLLC main 2187'},
  {key:'KC6',      name:'KC6',                   ba:''},
  {key:'MTG7',     name:'MTG-7 / Rutva',         ba:''},
  {key:'HARRY',    name:'Harry (Personal)',       ba:'Harry Wfargo / Truist'},
];
const SM=Object.fromEntries(STORES.map(s=>[s.key,s]));
let cfg={},txns=[],pmts=[],authed=false,splitCnt=0,saveTimer=null;

/* ── BOOT — fix: directly set display:none instead of class toggle ── */
window.addEventListener('load',()=>{
  cfg=JSON.parse(localStorage.getItem('cap1_cfg')||'null')||{};
  document.getElementById('loading').style.display='none';
  if(!cfg.mode){showScr('screen-setup');return;}
  showScr('screen-login');
});

function showScr(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

/* ── SETUP ── */
let selM='';
function selMode(m){
  selM=m;
  document.getElementById('btn-online').classList.toggle('sel',m==='online');
  document.getElementById('btn-local').classList.toggle('sel',m==='local');
  document.getElementById('online-setup').style.display=m==='online'?'block':'none';
}
async function saveSetup(){
  const msgEl=document.getElementById('setup-msg');
  msgEl.style.display='none';
  if(!selM){showMsg(msgEl,'Please choose a storage mode.','aw');return;}
  if(selM==='online'){
    const url=document.getElementById('s-url').value.trim();
    const token=document.getElementById('s-token').value.trim();
    if(!url||!token){showMsg(msgEl,'Please fill in the Script URL and Secret Token.','aw');return;}
    showMsg(msgEl,'🔄 Testing connection to Google Sheets...','aw');
    try{
      const res=await fetch(`${url}?token=${encodeURIComponent(token)}`);
      if(!res.ok) throw new Error(`HTTP ${res.status}`);
      const json=await res.json();
      if(json.error) throw new Error(json.error);
      cfg={mode:'online',scriptUrl:url,token};
    }catch(e){
      showMsg(msgEl,'❌ Could not connect: '+e.message,'ae');
      return;
    }
  }else{
    cfg={mode:'local'};
  }
  localStorage.setItem('cap1_cfg',JSON.stringify(cfg));
  msgEl.style.display='none';
  showScr('screen-login');
}
function resetSetup(){
  localStorage.removeItem('cap1_cfg');cfg={};authed=false;txns=[];pmts=[];
  showScr('screen-setup');
}

/* ── AUTH ── */
function togVis(id,btn){
  const el=document.getElementById(id);
  el.type=el.type==='password'?'text':'password';
  btn.textContent=el.type==='password'?'👁️':'🙈';
}
function login(){
  const pw=document.getElementById('login-pw').value;
  const errEl=document.getElementById('login-err');
  if(btoa(pw)===PASS_B64){
    errEl.classList.remove('show');authed=true;
    document.getElementById('login-pw').value='';
    loadData();
  }else{
    errEl.classList.add('show');
    document.getElementById('login-pw').select();
  }
}
function logout(){authed=false;txns=[];pmts=[];showScr('screen-login');}

/* ── DATA SYNC ── */
async function loadData(){
  setSyn('loading','🔄 Loading...');
  try{
    if(cfg.mode==='online'){
      const res=await fetch(`${cfg.scriptUrl}?token=${encodeURIComponent(cfg.token)}`);
      if(!res.ok) throw new Error(`HTTP ${res.status}`);
      const json=await res.json();
      if(json.error) throw new Error(json.error);
      txns=json.txns||[];
      pmts=json.payments||[];
      setSyn('ok','✅ Google Sheets');
    }else{
      txns=JSON.parse(localStorage.getItem('cap1_txns')||'[]');
      pmts=JSON.parse(localStorage.getItem('cap1_pmts')||'[]');
      setSyn('ok','💾 Local');
    }
  }catch(e){
    txns=JSON.parse(localStorage.getItem('cap1_txns')||'[]');
    pmts=JSON.parse(localStorage.getItem('cap1_pmts')||'[]');
    setSyn('err','⚠️ Offline — local copy');
  }
  initApp();
  showScr('screen-app');
}
async function persist(){
  localStorage.setItem('cap1_txns',JSON.stringify(txns));
  localStorage.setItem('cap1_pmts',JSON.stringify(pmts));
  updateSub();
  if(cfg.mode!=='online') return;
  clearTimeout(saveTimer);
  setSyn('saving','🔄 Saving...');
  saveTimer=setTimeout(async()=>{
    try{
      const res=await fetch(cfg.scriptUrl,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({token:cfg.token,txns,payments:pmts})
      });
      if(!res.ok) throw new Error(`HTTP ${res.status}`);
      const json=await res.json();
      if(json.error) throw new Error(json.error);
      setSyn('ok','✅ Saved to Sheets');
    }catch(e){
      setSyn('err','⚠️ Sheets sync failed');
    }
  },800);
}
function setSyn(state,txt){
  const el=document.getElementById('sync-st');if(!el)return;
  el.textContent=txt;
  el.style.background=state==='ok'?'#D1E7DD':state==='err'?'#F8D7DA':'rgba(0,0,0,.1)';
  el.style.color=state==='ok'?'#0A3622':state==='err'?'#842029':'#333';
}

/* ── INIT ── */
function initApp(){
  const opts=STORES.map(s=>`<option value="${s.key}">${s.name}</option>`).join('');
  ['f-store','flt-store','cpa-store'].forEach(id=>{
    const el=document.getElementById(id);if(!el)return;
    const pre=id==='f-store'?'<option value="">-- Select Store --</option>':'<option value="">All Stores</option>';
    el.innerHTML=pre+opts;
  });
  document.getElementById('f-date').value=today();
  const y=new Date().getFullYear();
  document.getElementById('cpa-from').value=`${y}-01-01`;
  document.getElementById('cpa-to').value=today();
  if(!document.querySelector('#split-rows .sr-item')) addSR();
  updateSub();
  renderPending();
}

/* ── TABS ── */
function swTab(tab,btn){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.nav button').forEach(b=>b.classList.remove('active'));
  document.getElementById('tab-'+tab).classList.add('active');
  btn.classList.add('active');
  if(tab==='pending') renderPending();
  if(tab==='records') renderRec();
  if(tab==='pay')     renderPay();
  if(tab==='history') renderHist();
}
function updateSub(){
  const pend=txns.filter(t=>t.status==='PENDING');
  const tot=pend.reduce((s,t)=>s+t.amount,0);
  const el=document.getElementById('hdr-sub');
  if(el) el.textContent=`${cfg.mode==='online'?'☁️ Google Sheets':'💾 Local'} · ${pend.length} pending · $${fmt(tot)} due`;
}

/* ── SPLIT ── */
function togSplit(){
  const on=document.getElementById('f-split').checked;
  document.getElementById('single-sec').style.display=on?'none':'block';
  document.getElementById('split-sec').style.display=on?'block':'none';
}
function addSR(){
  splitCnt++;
  const rid='sr-'+splitCnt;
  const opts=STORES.map(s=>`<option value="${s.key}">${s.name}</option>`).join('');
  const d=document.createElement('div');
  d.className='sr-item';d.id=rid;
  d.innerHTML=`
    <div class="fg"><label>Store</label>
      <select class="sr-st" onchange="chkSplit()" style="width:100%;padding:9px;border:2px solid #ddd;border-radius:7px;">
        <option value="">-- Select --</option>${opts}</select></div>
    <div class="fg" style="width:100px;"><label>Amount $</label>
      <input type="number" class="sr-am" placeholder="0.00" step="0.01" min="0"
        oninput="chkSplit()" style="width:100%;padding:9px;border:2px solid #ddd;border-radius:7px;font-size:.87rem;"></div>
    <button class="btn btn-gray btn-sm" style="height:38px;align-self:end;"
      onclick="document.getElementById('${rid}').remove();chkSplit()">✕</button>`;
  document.getElementById('split-rows').appendChild(d);
}
function chkSplit(){
  const total=parseFloat(document.getElementById('f-amount').value)||0;
  const st=[...document.querySelectorAll('.sr-am')].reduce((s,i)=>s+(parseFloat(i.value)||0),0);
  const el=document.getElementById('split-chk');
  if(!total){el.textContent='';return;}
  const diff=Math.abs(total-st);
  if(diff<0.02){el.textContent='✅ OK';el.style.color='#198754';}
  else{el.textContent=`Split $${fmt(st)} · diff $${fmt(diff)}`;el.style.color='#CC0000';}
}

/* ── ADD TRANSACTION ── */
function addTxn(){
  const date=document.getElementById('f-date').value;
  const amount=parseFloat(document.getElementById('f-amount').value);
  const vendor=document.getElementById('f-vendor').value.trim();
  const purpose=document.getElementById('f-purpose').value.trim();
  const notes=document.getElementById('f-notes').value.trim();
  const isSplit=document.getElementById('f-split').checked;
  if(!date||!vendor||isNaN(amount)||amount<=0||!purpose){
    showAlert('add-alert','⚠️ Fill in Date, Vendor, Amount, and Purpose.','aw');return;
  }
  let stores=[];
  if(!isSplit){
    const sk=document.getElementById('f-store').value;
    if(!sk){showAlert('add-alert','⚠️ Select a store.','aw');return;}
    stores=[{storeKey:sk,amount}];
  }else{
    const sts=[...document.querySelectorAll('.sr-st')];
    const ams=[...document.querySelectorAll('.sr-am')];
    let st=0;
    for(let i=0;i<sts.length;i++){
      const sk=sts[i].value,sa=parseFloat(ams[i].value);
      if(!sk||isNaN(sa)||sa<=0){showAlert('add-alert','⚠️ Fill all split rows.','aw');return;}
      stores.push({storeKey:sk,amount:sa});st+=sa;
    }
    if(Math.abs(st-amount)>0.02){showAlert('add-alert',`⚠️ Split $${fmt(st)} ≠ total $${fmt(amount)}.`,'aw');return;}
  }
  txns.push({id:uid(),postedDate:date,chargedBy:vendor,amount,purpose,notes,stores,
    status:'PENDING',paymentId:null,createdAt:new Date().toISOString()});
  persist();
  ['f-vendor','f-amount','f-purpose','f-notes'].forEach(i=>document.getElementById(i).value='');
  document.getElementById('f-store').value='';
  document.getElementById('f-split').checked=false;
  document.getElementById('split-rows').innerHTML='';
  splitCnt=0;togSplit();addSR();
  document.getElementById('f-date').value=today();
  showAlert('add-alert',`✅ Added: ${vendor} — $${fmt(amount)}`,'as');
}

/* ── PENDING ── */
function renderPending(){
  const pend=txns.filter(t=>t.status==='PENDING');
  const bySt={};
  pend.forEach(t=>{t.stores.forEach(s=>{
    if(!bySt[s.storeKey]) bySt[s.storeKey]={items:[],total:0};
    bySt[s.storeKey].items.push({t,amt:s.amount});
    bySt[s.storeKey].total+=s.amount;
  });});
  const grand=Object.values(bySt).reduce((s,g)=>s+g.total,0);
  const sc=Object.keys(bySt).length;
  const sumEl=document.getElementById('pend-sum');
  if(sumEl) sumEl.innerHTML=`
    <div class="si"><div class="val">${pend.length}</div><div class="lbl">Charges</div></div>
    <div class="si"><div class="val">${sc}</div><div class="lbl">Stores</div></div>
    <div class="si"><div class="val">$${fmt(grand)}</div><div class="lbl">Total Pending</div></div>`;
  if(!sc){document.getElementById('pend-body').innerHTML='<div class="es"><div class="ei">✅</div><p>All caught up!</p></div>';return;}
  document.getElementById('pend-body').innerHTML=Object.keys(bySt).sort().map(sk=>{
    const store=SM[sk];const{items,total}=bySt[sk];
    const rows=items.map(({t,amt})=>`
      <div class="tr-row">
        <span class="tdate">${fd(t.postedDate)}</span>
        <div class="ti"><div class="tv">${esc(t.chargedBy)}</div>
          <div class="tp">${esc(t.purpose)}${t.notes?' · '+esc(t.notes):''}</div></div>
        <span class="ta">$${fmt(amt)}</span>
      </div>`).join('');
    return `<div class="sc">
      <div class="sch">
        <div><h3>${store?store.name:sk}</h3>
          <div class="acct">${store&&store.ba?store.ba+' · ':''}${items.length} charge${items.length!==1?'s':''}</div></div>
        <div class="sch-r">
          <div class="stot">$${fmt(total)}</div>
          <button class="btn btn-red btn-sm" onclick="openPayModal('${sk}')" style="margin-top:5px;">Pay Now</button>
        </div>
      </div>
      <div class="scb">${rows}</div>
    </div>`;
  }).join('');
}

/* ── RECORDS ── */
function renderRec(){
  const fs=document.getElementById('flt-store').value;
  const fst=document.getElementById('flt-stat').value;
  const mob=window.innerWidth<700;
  let list=[...txns];
  if(fs)  list=list.filter(t=>t.stores.some(s=>s.storeKey===fs));
  if(fst) list=list.filter(t=>t.status===fst);
  list.sort((a,b)=>new Date(b.postedDate)-new Date(a.postedDate));
  document.getElementById('rec-cnt').textContent=`${list.length} record${list.length!==1?'s':''} shown`;
  if(mob){
    document.getElementById('rec-desk').style.display='none';
    document.getElementById('rec-mob').style.display='block';
    renderMob(list);
  }else{
    document.getElementById('rec-desk').style.display='block';
    document.getElementById('rec-mob').style.display='none';
    renderDesk(list);
  }
}
function renderDesk(list){
  if(!list.length){document.getElementById('rec-tbody').innerHTML='<tr><td colspan="11" style="text-align:center;padding:20px;color:#999;">No records.</td></tr>';return;}
  document.getElementById('rec-tbody').innerHTML=list.map(t=>{
    const pmt=pmts.find(p=>p.id===t.paymentId);
    const paid=t.status==='PAID';
    const sn=t.stores.map(s=>{const st=SM[s.storeKey];const l=st?st.name:s.storeKey;return t.stores.length>1?`${l} ($${fmt(s.amount)})`:l;}).join('<br>');
    const ac=[...new Set(t.stores.map(s=>SM[s.storeKey]?.ba).filter(Boolean))].join(', ');
    return `<tr class="${paid?'pr':''}">
      <td>${fd(t.postedDate)}</td><td><strong>${esc(t.chargedBy)}</strong></td>
      <td><strong style="color:#CC0000;">$${fmt(t.amount)}</strong></td>
      <td>${sn}</td><td style="font-size:.68rem;color:#888;">${esc(ac)}</td>
      <td>${esc(t.purpose)}</td><td style="font-size:.68rem;color:#999;">${esc(t.notes||'')}</td>
      <td>${pmt?fd(pmt.payoffDate):'—'}</td>
      <td style="font-family:monospace;color:#0A3622;font-weight:700;">${pmt?esc(pmt.confirmationNumber):'—'}</td>
      <td><span class="badge ${paid?'bpa':'bp'}">${paid?'PAID':'PENDING'}</span></td>
      <td>${!paid?`<button class="btn btn-gray btn-sm" onclick="openDelModal('${t.id}')">🗑</button>`
                 :`<button class="btn btn-yellow btn-sm" onclick="openUndoModal('${t.id}')">↩️</button>`}</td>
    </tr>`;
  }).join('');
}
function renderMob(list){
  if(!list.length){document.getElementById('rec-mob').innerHTML='<div class="es"><p>No records.</p></div>';return;}
  document.getElementById('rec-mob').innerHTML=list.map(t=>{
    const pmt=pmts.find(p=>p.id===t.paymentId);
    const paid=t.status==='PAID';
    const sn=t.stores.map(s=>SM[s.storeKey]?.name||s.storeKey).join(', ');
    return `<div class="mrc ${paid?'mpa':'mpe'}">
      <div class="mrc-h"><div class="mrc-v">${esc(t.chargedBy)}</div><div class="mrc-a">$${fmt(t.amount)}</div></div>
      <div class="mrc-m">${fd(t.postedDate)} · ${esc(sn)}</div>
      <div class="mrc-m">${esc(t.purpose)}</div>
      ${pmt?`<div class="mrc-m" style="color:#0A3622;font-weight:600;">✅ ${fd(pmt.payoffDate)} · ${esc(pmt.confirmationNumber)}</div>`:''}
      <div class="mrc-f">
        <span class="badge ${paid?'bpa':'bp'}">${paid?'PAID':'PENDING'}</span>
        ${!paid?`<button class="btn btn-gray btn-sm" onclick="openDelModal('${t.id}')">🗑</button>`
               :`<button class="btn btn-yellow btn-sm" onclick="openUndoModal('${t.id}')">↩️</button>`}
      </div>
    </div>`;
  }).join('');
}

/* ── PAY TAB ── */
function renderPay(){
  const bySt={};
  txns.filter(t=>t.status==='PENDING').forEach(t=>{t.stores.forEach(s=>{
    if(!bySt[s.storeKey]) bySt[s.storeKey]={count:0,total:0};
    bySt[s.storeKey].count++;bySt[s.storeKey].total+=s.amount;
  });});
  if(!Object.keys(bySt).length){document.getElementById('pay-body').innerHTML='<div class="es"><div class="ei">✅</div><p>Nothing to pay!</p></div>';return;}
  document.getElementById('pay-body').innerHTML=Object.keys(bySt).sort().map(sk=>{
    const st=SM[sk];const{count,total}=bySt[sk];
    return `<div class="sc"><div class="sch">
      <div><h3>${st?st.name:sk}</h3>
        <div class="acct">${st&&st.ba?'Pay from: '+st.ba+' · ':''} ${count} charge${count!==1?'s':''}</div></div>
      <div class="sch-r">
        <div class="stot">$${fmt(total)}</div>
        <button class="btn btn-green btn-sm" onclick="openPayModal('${sk}')" style="margin-top:5px;">✅ Mark Paid</button>
      </div>
    </div></div>`;
  }).join('');
}

/* ── PAY MODAL ── */
let actSK=null;
function openPayModal(sk){
  actSK=sk;const store=SM[sk];
  const pend=txns.filter(t=>t.status==='PENDING'&&t.stores.some(s=>s.storeKey===sk));
  const total=pend.reduce((s,t)=>{const si=t.stores.find(x=>x.storeKey===sk);return s+(si?.amount||0);},0);
  document.getElementById('mp-title').textContent=`Pay — ${store?store.name:sk}`;
  document.getElementById('mp-sum').innerHTML=
    pend.map(t=>{const si=t.stores.find(x=>x.storeKey===sk);
      return `<div class="md-row"><span>${esc(t.chargedBy)}</span><strong>$${fmt(si?.amount||0)}</strong></div>`;
    }).join('')+
    `<div class="md-tot"><span>TOTAL DUE</span><span>$${fmt(total)}</span></div>
     <div class="md-row" style="margin-top:7px;font-size:.76rem;color:#666;">
       <span>Pay from:</span><strong>${store?store.ba:'—'}</strong></div>`;
  document.getElementById('mp-date').value=today();
  document.getElementById('mp-total').value=total.toFixed(2);
  document.getElementById('mp-conf').value='';
  document.getElementById('mp-note').value=`$${fmt(total)} paid via ${store?store.name:sk} ops acc`;
  openModal('mo-pay');
}
function confirmPay(){
  const payoffDate=document.getElementById('mp-date').value;
  const conf=document.getElementById('mp-conf').value.trim().toUpperCase();
  const totalPaid=parseFloat(document.getElementById('mp-total').value);
  const note=document.getElementById('mp-note').value.trim();
  if(!payoffDate||!conf){alert('Enter Payoff Date and Confirmation Number.');return;}
  const pmt={id:uid(),storeKey:actSK,payoffDate,totalPaid,confirmationNumber:conf,
    payNote:note,createdAt:new Date().toISOString(),transactionIds:[]};
  txns.forEach(t=>{
    if(t.status==='PENDING'&&t.stores.some(s=>s.storeKey===actSK)){
      t.status='PAID';t.paymentId=pmt.id;pmt.transactionIds.push(t.id);
    }
  });
  pmts.push(pmt);persist();closeModal();
  const at=document.querySelector('.tab.active')?.id;
  if(at==='tab-pending') renderPending();
  if(at==='tab-pay')     renderPay();
  if(at==='tab-records') renderRec();
  if(at==='tab-history') renderHist();
  const st=SM[actSK];
  alert(`✅ Payment Recorded!\n\nStore: ${st?st.name:actSK}\nPaid: $${fmt(totalPaid)}\nConfo: ${conf}\nDate: ${payoffDate}`);
}

/* ── HISTORY ── */
function renderHist(){
  if(!pmts.length){document.getElementById('hist-body').innerHTML='<div class="es"><div class="ei">🏦</div><p>No payments yet.</p></div>';return;}
  const sorted=[...pmts].sort((a,b)=>new Date(b.payoffDate)-new Date(a.payoffDate));
  document.getElementById('hist-body').innerHTML=sorted.map(p=>{
    const st=SM[p.storeKey];const cnt=p.transactionIds.length;
    return `<div class="phi">
      <div class="phi-h"><span>${st?st.name:p.storeKey}</span><span style="color:#CC0000;">$${fmt(p.totalPaid)}</span></div>
      <div class="phi-d">📅 ${fd(p.payoffDate)} &nbsp;·&nbsp; 🔑 <strong style="font-family:monospace;">${esc(p.confirmationNumber)}</strong></div>
      <div class="phi-d">🏦 ${st?st.ba:''} &nbsp;·&nbsp; ${cnt} transaction${cnt!==1?'s':''}</div>
      ${p.payNote?`<div class="phi-d" style="color:#0A3622;margin-top:3px;">${esc(p.payNote)}</div>`:''}
    </div>`;
  }).join('');
}

/* ── DELETE/UNDO ── */
let delId=null,undoId=null;
function openDelModal(id){
  delId=id;const t=txns.find(x=>x.id===id);if(!t)return;
  document.getElementById('md-del-d').textContent=`Delete "${t.chargedBy}" — $${fmt(t.amount)} posted ${fd(t.postedDate)}? This cannot be undone.`;
  openModal('mo-del');
}
function confirmDel(){txns=txns.filter(t=>t.id!==delId);persist();closeModal();renderRec();renderPending();}
function openUndoModal(id){
  undoId=id;const t=txns.find(x=>x.id===id);if(!t)return;
  const pmt=pmts.find(p=>p.id===t.paymentId);
  document.getElementById('md-undo-d').textContent=`This reverses the entire payment batch containing "${t.chargedBy}" and removes confo# ${pmt?.confirmationNumber||''}. All transactions in that batch go back to PENDING.`;
  openModal('mo-undo');
}
function confirmUndo(){
  const t=txns.find(x=>x.id===undoId);if(!t){closeModal();return;}
  const pmtId=t.paymentId;
  txns.forEach(x=>{if(x.paymentId===pmtId){x.status='PENDING';x.paymentId=null;}});
  pmts=pmts.filter(p=>p.id!==pmtId);
  persist();closeModal();renderRec();renderPending();
}

/* ── IMPORT ── */
let impRows=[];
function parseImp(){
  const text=document.getElementById('imp-text').value.trim();
  if(!text)return;
  const lines=text.split('\n').map(l=>l.trim()).filter(Boolean);
  impRows=[];
  lines.forEach(line=>{
    let parts=line.split('\t');
    if(parts.length<3) parts=line.split(',');
    if(parts.length<3) return;
    const rawDate=parts[0].trim().replace(/^["']+|["']+$/g,'');
    const rawDesc=parts.slice(1,parts.length-1).join(' ').trim().replace(/^["']+|["']+$/g,'');
    const rawAmt=parts[parts.length-1].trim().replace(/^["']+|["']+$/g,'');
    const amount=parseFloat(rawAmt.replace(/[$,\s]/g,''));
    if(isNaN(amount)||amount===0) return;
    let date='';
    if(/\d{1,2}\/\d{1,2}\/\d{4}/.test(rawDate)){
      const[m,d,y]=rawDate.split('/');date=`${y}-${m.padStart(2,'0')}-${d.padStart(2,'0')}`;
    }else if(/\d{4}-\d{2}-\d{2}/.test(rawDate)){date=rawDate;}else return;
    impRows.push({date,desc:rawDesc,amount:Math.abs(amount)});
  });
  if(!impRows.length){document.getElementById('imp-prev').innerHTML='<div class="alert aw">⚠️ Could not parse. Check format.</div>';return;}
  const sopts='<option value="">-- Select Store --</option>'+STORES.map(s=>`<option value="${s.key}">${s.name}</option>`).join('');
  let html=`<div class="card"><div class="ct">Parsed ${impRows.length} transaction${impRows.length!==1?'s':''} — fill Store &amp; Purpose:</div>`;
  impRows.forEach((r,i)=>{html+=`
    <div class="icard">
      <div style="display:flex;justify-content:space-between;margin-bottom:7px;">
        <div><strong>${esc(r.desc)}</strong><div style="font-size:.7rem;color:#888;">${fd(r.date)}</div></div>
        <div style="font-size:1rem;font-weight:800;color:#CC0000;">$${fmt(r.amount)}</div>
      </div>
      <div class="fr">
        <div class="fg" style="margin-bottom:0;"><label>Store *</label><select id="is-${i}">${sopts}</select></div>
        <div class="fg" style="margin-bottom:0;"><label>Purpose *</label>
          <input type="text" id="ip-${i}" placeholder="What is this for?"></div>
      </div>
    </div>`;});
  html+=`<button class="btn btn-green btn-full" onclick="impAll()" style="margin-top:4px;">📥 Import All</button></div>`;
  document.getElementById('imp-prev').innerHTML=html;
}
function impAll(){
  let cnt=0;
  impRows.forEach((r,i)=>{
    const sk=document.getElementById(`is-${i}`)?.value;
    const pu=document.getElementById(`ip-${i}`)?.value.trim();
    if(!sk||!pu) return;
    txns.push({id:uid(),postedDate:r.date,chargedBy:r.desc,amount:r.amount,purpose:pu,notes:'',
      stores:[{storeKey:sk,amount:r.amount}],status:'PENDING',paymentId:null,createdAt:new Date().toISOString()});
    cnt++;
  });
  persist();
  document.getElementById('imp-text').value='';
  document.getElementById('imp-prev').innerHTML=`<div class="alert as">✅ Imported ${cnt} transaction${cnt!==1?'s':''}!</div>`;
  impRows=[];
}

/* ── CSV ── */
function exportCSV(){
  const fs=document.getElementById('flt-store').value;
  const fst=document.getElementById('flt-stat').value;
  let list=[...txns];
  if(fs)  list=list.filter(t=>t.stores.some(s=>s.storeKey===fs));
  if(fst) list=list.filter(t=>t.status===fst);
  list.sort((a,b)=>new Date(a.postedDate)-new Date(b.postedDate));
  const hdr=['Posted Date','Charged By','Amount','Store','Ops Account','Purpose','Notes',
    'Payoff Date','Confirmation #','Status','Amount Paid','Pay Note'];
  const rows=list.flatMap(t=>t.stores.map(s=>{
    const st=SM[s.storeKey];const pmt=pmts.find(p=>p.id===t.paymentId);
    return[t.postedDate,t.chargedBy,t.amount.toFixed(2),
      st?st.name:s.storeKey,st?st.ba:'',t.purpose,t.notes||'',
      pmt?pmt.payoffDate:'',pmt?pmt.confirmationNumber:'',
      t.status,pmt?pmt.totalPaid.toFixed(2):'',pmt?pmt.payNote:''];
  }));
  const csv=[hdr,...rows].map(r=>r.map(c=>`"${String(c||'').replace(/"/g,'""')}"`).join(',')).join('\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8;'}));
  a.download=`CapOne_${today()}.csv`;a.click();
}

/* ── CPA ── */
function openCPA(){renderCPA();showScr('screen-cpa');}
function closeCPA(){showScr('screen-app');}
function renderCPA(){
  const from=document.getElementById('cpa-from').value;
  const to  =document.getElementById('cpa-to').value;
  const fsk =document.getElementById('cpa-store').value;
  let list=[...txns];
  if(fsk)  list=list.filter(t=>t.stores.some(s=>s.storeKey===fsk));
  if(from) list=list.filter(t=>t.postedDate>=from);
  if(to)   list=list.filter(t=>t.postedDate<=to);
  list.sort((a,b)=>new Date(a.postedDate)-new Date(b.postedDate));
  const stSum={};
  list.forEach(t=>{t.stores.forEach(s=>{
    if(fsk&&s.storeKey!==fsk) return;
    if(!stSum[s.storeKey]) stSum[s.storeKey]={name:SM[s.storeKey]?.name||s.storeKey,total:0,paid:0,pending:0,cnt:0};
    stSum[s.storeKey].total+=s.amount;stSum[s.storeKey].cnt++;
    if(t.status==='PAID') stSum[s.storeKey].paid+=s.amount;
    else stSum[s.storeKey].pending+=s.amount;
  });});
  const gTot=Object.values(stSum).reduce((s,g)=>s+g.total,0);
  const gPd =Object.values(stSum).reduce((s,g)=>s+g.paid,0);
  const gPn =Object.values(stSum).reduce((s,g)=>s+g.pending,0);
  const storeName=fsk&&SM[fsk]?SM[fsk].name:'All Stores';
  const period=from&&to?`${fd(from)} – ${fd(to)}`:'All Dates';
  document.getElementById('cpa-body').innerHTML=`
    <div class="cpa-hdr">
      <h1>💳 Capital One Payment Record</h1>
      <p><strong>SQS Card</strong> · ${storeName} · Period: ${period}</p>
      <p style="font-size:.76rem;color:#aaa;margin-top:5px;">Generated: ${new Date().toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</p>
    </div>
    <div class="cpa-sec">Executive Summary</div>
    <table class="cpa-st">
      <tr><td style="width:55%"><strong>Report Period</strong></td><td>${period}</td></tr>
      <tr><td><strong>Store(s)</strong></td><td>${storeName}</td></tr>
      <tr><td><strong>Total Transactions</strong></td><td>${list.length}</td></tr>
      <tr><td><strong>Total Charges</strong></td><td><strong>$${fmt(gTot)}</strong></td></tr>
      <tr><td><strong>Total Paid</strong></td><td style="color:#198754;"><strong>$${fmt(gPd)}</strong></td></tr>
      <tr><td><strong>Outstanding / Pending</strong></td><td style="color:#CC0000;"><strong>$${fmt(gPn)}</strong></td></tr>
    </table>
    <div class="cpa-sec">Charges by Store</div>
    <table class="cpa-st">
      <thead><tr><th>Store</th><th>Transactions</th><th>Total</th><th>Paid</th><th>Pending</th></tr></thead>
      <tbody>${Object.keys(stSum).sort().map(sk=>{const g=stSum[sk];return`<tr>
        <td>${esc(g.name)}</td><td>${g.cnt}</td>
        <td>$${fmt(g.total)}</td><td style="color:#198754;">$${fmt(g.paid)}</td>
        <td style="color:#CC0000;">$${fmt(g.pending)}</td></tr>`;}).join('')}</tbody>
      <tfoot><tr>
        <td><strong>TOTAL</strong></td><td><strong>${list.length}</strong></td>
        <td><strong>$${fmt(gTot)}</strong></td>
        <td style="color:#198754;"><strong>$${fmt(gPd)}</strong></td>
        <td style="color:#CC0000;"><strong>$${fmt(gPn)}</strong></td>
      </tr></tfoot>
    </table>
    <div class="cpa-sec">Detailed Transaction List</div>
    <table class="cpa-tx">
      <thead><tr><th>Date</th><th>Charged By</th><th>Amount</th><th>Store</th>
        <th>Purpose</th><th>Notes</th><th>Payoff Date</th><th>Confo #</th><th>Status</th></tr></thead>
      <tbody>${list.map(t=>{
        const pmt=pmts.find(p=>p.id===t.paymentId);
        const paid=t.status==='PAID';
        const sn=t.stores.map(s=>SM[s.storeKey]?.name||s.storeKey).join(' / ');
        return`<tr class="${paid?'cpr':''}">
          <td>${fd(t.postedDate)}</td><td><strong>${esc(t.chargedBy)}</strong></td>
          <td>$${fmt(t.amount)}</td><td>${esc(sn)}</td><td>${esc(t.purpose)}</td>
          <td style="color:#888;">${esc(t.notes||'')}</td>
          <td>${pmt?fd(pmt.payoffDate):'—'}</td>
          <td style="font-family:monospace;font-size:.8rem;font-weight:700;">${pmt?esc(pmt.confirmationNumber):'—'}</td>
          <td><span class="badge ${paid?'bpa':'bp'}">${paid?'PAID':'PENDING'}</span></td>
        </tr>`;}).join('')||'<tr><td colspan="9" style="text-align:center;padding:16px;color:#999;">No transactions.</td></tr>'}</tbody>
    </table>
    <div class="cpa-ft">Capital One SQS Card · Prepared by Harry Desai · ${new Date().toLocaleDateString()}</div>`;
}

/* ── MODAL HELPERS ── */
function openModal(id){document.getElementById(id).classList.add('open');}
function closeModal(){
  document.querySelectorAll('.mo').forEach(m=>m.classList.remove('open'));
  actSK=delId=undoId=null;
}
document.querySelectorAll('.mo').forEach(el=>{
  el.addEventListener('click',e=>{if(e.target===el)closeModal();});
});

/* ── UTILS ── */
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7);}
function today(){return new Date().toISOString().split('T')[0];}
function fmt(n){return(Math.round(n*100)/100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,',');}
function fd(iso){if(!iso)return'';try{const[y,m,d]=iso.split('-');return`${parseInt(m)}/${parseInt(d)}/${y}`;}catch(e){return iso;}}
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function showMsg(el,msg,cls){el.className='alert '+cls;el.textContent=msg;el.style.display='block';}
function showAlert(id,msg,cls){
  const el=document.getElementById(id);if(!el)return;
  el.innerHTML=`<div class="alert ${cls}">${msg}</div>`;
  setTimeout(()=>{if(el)el.innerHTML='';},5000);
}
let rTimer;
window.addEventListener('resize',()=>{
  clearTimeout(rTimer);
  rTimer=setTimeout(()=>{if(document.getElementById('tab-records').classList.contains('active'))renderRec();},250);
});
</script>
