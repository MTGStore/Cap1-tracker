<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Capital One Payment Record</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f0f0f0;color:#222;-webkit-tap-highlight-color:transparent;min-height:100vh}
.screen{display:none;min-height:100vh}.screen.active{display:block}

.auth-wrap{min-height:100vh;display:flex;align-items:flex-start;justify-content:center;background:linear-gradient(135deg,#CC0000,#880000);padding:20px;padding-top:30px}
.auth-box{background:white;border-radius:16px;padding:26px;width:100%;max-width:500px;box-shadow:0 10px 40px rgba(0,0,0,.35)}
.auth-logo{text-align:center;margin-bottom:20px}
.auth-logo .icon{font-size:2.6rem}
.auth-logo h1{color:#CC0000;font-size:1.3rem;font-weight:900;margin-top:6px}
.auth-logo p{color:#888;font-size:.78rem;margin-top:3px}

.step-box{background:#FFF9E6;border:2px solid #FFD700;border-radius:10px;padding:13px;margin-bottom:12px}
.step-num{display:inline-flex;align-items:center;justify-content:center;background:#CC0000;color:white;border-radius:50%;width:22px;height:22px;font-size:.72rem;font-weight:800;margin-right:7px;flex-shrink:0}
.step-title{font-size:.88rem;font-weight:700;color:#333;display:inline}
.step-body{font-size:.8rem;color:#555;margin-top:8px;line-height:1.65;padding-left:2px}
.step-body ol{padding-left:16px}
.step-body li{margin-bottom:3px}
.step-body code{background:#f0f0f0;padding:1px 6px;border-radius:4px;font-size:.76rem;font-family:monospace;color:#CC0000}
.step-body strong{color:#222}

.mode-btn{display:block;width:100%;padding:13px;border:3px solid #ddd;border-radius:10px;background:white;font-size:.9rem;font-weight:700;cursor:pointer;margin-bottom:10px;text-align:left;transition:all .15s}
.mode-btn:hover,.mode-btn.sel{border-color:#CC0000;background:#FFF9E6}
.mode-btn .mi{font-size:1.3rem;margin-right:8px}
.mode-btn small{display:block;font-weight:400;color:#888;font-size:.74rem;margin-top:3px;padding-left:30px}

.fg{margin-bottom:13px}
.fg label{display:block;font-size:.72rem;font-weight:700;color:#CC0000;margin-bottom:4px;text-transform:uppercase;letter-spacing:.4px}
.fg input,.fg select,.fg textarea{width:100%;padding:10px 12px;border:2px solid #ddd;border-radius:7px;font-size:.92rem;background:white;color:#222;appearance:auto}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:#FFD700;outline:none;box-shadow:0 0 0 3px rgba(255,215,0,.25)}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.err{color:#CC0000;font-size:.78rem;margin-top:5px;display:none}.err.show{display:block}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;padding:10px 18px;border:none;border-radius:8px;font-size:.86rem;font-weight:700;cursor:pointer;transition:opacity .15s}
.btn:active{opacity:.75}
.btn-red{background:#CC0000;color:white}.btn-green{background:#198754;color:white}
.btn-yellow{background:#FFD700;color:#222}.btn-gray{background:#6c757d;color:white}
.btn-outline{background:white;border:2px solid #CC0000;color:#CC0000}
.btn-sm{padding:6px 11px;font-size:.76rem;border-radius:6px}
.btn-full{width:100%;padding:13px;font-size:.95rem}
.pw{position:relative}.pw input{padding-right:44px}
.pw-tog{position:absolute;right:11px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:1rem;color:#999;padding:4px}

.hdr{background:#FFD700;padding:10px 13px 8px;border-bottom:4px solid #CC0000;position:sticky;top:0;z-index:200}
.hdr-top{display:flex;align-items:center;justify-content:space-between}
.hdr-title{color:#CC0000;font-size:1.1rem;font-weight:900}
.hdr-acts{display:flex;align-items:center;gap:7px}
.sync-badge{font-size:.68rem;padding:3px 8px;border-radius:20px;background:rgba(0,0,0,.1);color:#333;font-weight:600}
.hdr-sub{color:#555;font-size:.7rem;margin-top:2px}

.nav{display:flex;background:#1a1a1a;overflow-x:auto;position:sticky;top:58px;z-index:190;-webkit-overflow-scrolling:touch}
.nav button{padding:10px 12px;background:none;border:none;color:#aaa;font-size:.76rem;cursor:pointer;white-space:nowrap;border-bottom:3px solid transparent}
.nav button.active{color:#FFD700;border-bottom:3px solid #FFD700}

.content{padding:12px;max-width:960px;margin:0 auto}
.tab{display:none}.tab.active{display:block}
.card{background:white;border-radius:10px;padding:15px;margin-bottom:12px;box-shadow:0 2px 6px rgba(0,0,0,.09)}
.ct{color:#CC0000;font-size:.97rem;font-weight:800;margin-bottom:13px}

.sbar{background:linear-gradient(135deg,#CC0000,#880000);color:white;padding:13px 15px;border-radius:10px;margin-bottom:12px;display:flex;justify-content:space-around;flex-wrap:wrap;gap:8px}
.si{text-align:center}.si .val{font-size:1.3rem;font-weight:900}.si .lbl{font-size:.67rem;opacity:.8;margin-top:2px}

.sc{background:white;border-radius:10px;margin-bottom:11px;box-shadow:0 2px 6px rgba(0,0,0,.09);overflow:hidden;border-left:5px solid #FFD700}
.sch{background:#FFF9E6;padding:11px 13px;display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid #FFD700}
.sch h3{color:#CC0000;font-size:.9rem;font-weight:800}
.sch .acct{font-size:.67rem;color:#777;margin-top:2px}
.sch-r{text-align:right}.stot{font-size:1.2rem;font-weight:900;color:#CC0000}
.scb{padding:9px 13px}
.tr-row{display:flex;align-items:flex-start;padding:7px 0;border-bottom:1px solid #f2f2f2;gap:7px}
.tr-row:last-child{border-bottom:none}
.tdate{font-size:.7rem;color:#888;white-space:nowrap;min-width:56px;padding-top:2px}
.ti{flex:1}.tv{font-size:.85rem;font-weight:700}.tp{font-size:.71rem;color:#777;margin-top:1px}
.ta{font-size:.9rem;font-weight:800;color:#CC0000;white-space:nowrap}

.badge{display:inline-block;padding:2px 8px;border-radius:20px;font-size:.67rem;font-weight:700;text-transform:uppercase}
.bp{background:#FFF3CD;color:#7A5700;border:1px solid #FFD700}
.bpa{background:#D1E7DD;color:#0A3622;border:1px solid #A3CFBB}

.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.rt{width:100%;border-collapse:collapse;font-size:.74rem;min-width:680px}
.rt thead tr{background:#FFD700}
.rt th{padding:8px 7px;text-align:left;color:#CC0000;font-weight:800;white-space:nowrap;border-right:1px solid #f0c000}
.rt td{padding:6px 7px;border-bottom:1px solid #eee;border-right:1px solid #f8f8f8;vertical-align:top}
.rt tr:hover{background:#FFFDE7}.rt tr.pr{background:#F0FFF4}.rt tr.pr:hover{background:#E5FFED}
.mrc{background:white;border-radius:8px;padding:11px;margin-bottom:9px;box-shadow:0 1px 4px rgba(0,0,0,.09);border-left:4px solid #ddd}
.mrc.mpa{border-left-color:#198754}.mrc.mpe{border-left-color:#CC0000}
.mrc-h{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px}
.mrc-v{font-weight:800;font-size:.86rem}.mrc-a{font-weight:900;font-size:.95rem;color:#CC0000}
.mrc-m{font-size:.72rem;color:#777;margin-bottom:3px}
.mrc-f{display:flex;justify-content:space-between;align-items:center;margin-top:7px}

.split-box{background:#FFFDE7;border:2px dashed #FFD700;border-radius:8px;padding:11px;margin-top:4px}
.sr-item{display:grid;grid-template-columns:1fr auto auto;gap:8px;margin-bottom:8px;align-items:end}
.sr-item .fg{margin-bottom:0}

.mo{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:1000;align-items:center;justify-content:center;padding:14px}
.mo.open{display:flex}
.md{background:white;border-radius:14px;padding:20px;width:100%;max-width:460px;max-height:92vh;overflow-y:auto;box-shadow:0 8px 30px rgba(0,0,0,.3)}
.md-title{color:#CC0000;font-size:1rem;font-weight:800;margin-bottom:13px}
.md-sum{background:#FFF9E6;border:2px solid #FFD700;border-radius:8px;padding:11px;margin-bottom:13px}
.md-row{display:flex;justify-content:space-between;padding:3px 0;font-size:.84rem}
.md-tot{display:flex;justify-content:space-between;padding:7px 0 0;margin-top:5px;border-top:2px solid #FFD700;font-size:1.05rem;font-weight:800;color:#CC0000}
.md-foot{display:flex;gap:8px;margin-top:14px}

.alert{padding:9px 13px;border-radius:7px;margin-bottom:11px;font-size:.84rem;animation:fadeIn .3s}
.as{background:#D1E7DD;color:#0A3622;border:1px solid #A3CFBB}
.aw{background:#FFF3CD;color:#7A5700;border:1px solid #FFDA6A}
.ae{background:#F8D7DA;color:#842029;border:1px solid #F5C2C7}
@keyframes fadeIn{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:none}}

.ia{width:100%;min-height:100px;font-family:monospace;font-size:.79rem;padding:10px;border:2px solid #ddd;border-radius:7px;resize:vertical}
.icard{background:#f9f9f9;border-radius:8px;padding:11px;margin-bottom:9px;border-left:4px solid #FFD700}
.fbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;align-items:center}
.fbar select,.fbar input{padding:8px 10px;border:2px solid #ddd;border-radius:7px;font-size:.79rem;flex:1;min-width:90px;background:white}

.phi{border:1px solid #eee;border-radius:8px;padding:10px 12px;margin-bottom:8px;background:#F0FFF4}
.phi-h{display:flex;justify-content:space-between;font-weight:800;font-size:.88rem}
.phi-d{font-size:.71rem;color:#555;margin-top:3px}

/* Loading spinner — hidden by JS on load */
#loading{position:fixed;inset:0;background:rgba(255,215,0,.93);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;font-size:1rem;font-weight:700;color:#CC0000;gap:10px}
#loading .spin{font-size:2rem;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

#screen-cpa{background:white;min-height:100vh}
.cpa-tb{background:#1a1a1a;padding:10px 15px;display:flex;align-items:center;gap:9px;flex-wrap:wrap;position:sticky;top:0;z-index:100}
.cpa-tb h2{color:#FFD700;font-size:.95rem;font-weight:800;flex:1}
.cpa-tb select,.cpa-tb input{padding:7px 9px;border:none;border-radius:6px;font-size:.8rem;background:white}
.cpa-body{padding:22px;max-width:900px;margin:0 auto}
.cpa-hdr{text-align:center;margin-bottom:24px;padding-bottom:18px;border-bottom:3px solid #CC0000}
.cpa-hdr h1{font-size:1.4rem;color:#CC0000;font-weight:900}
.cpa-hdr p{color:#555;font-size:.85rem;margin-top:4px}
.cpa-sec{font-size:.95rem;font-weight:800;color:#CC0000;margin:20px 0 8px;padding-bottom:4px;border-bottom:2px solid #FFD700}
.cpa-st{width:100%;border-collapse:collapse;font-size:.82rem;margin-bottom:18px}
.cpa-st th{background:#FFD700;color:#CC0000;padding:8px 9px;text-align:left;font-weight:800;border:1px solid #ddd}
.cpa-st td{padding:7px 9px;border:1px solid #eee;vertical-align:top}
.cpa-st tr:nth-child(even){background:#FFFDE7}
.cpa-st tfoot td{background:#FFF3CD;font-weight:800;border-top:2px solid #CC0000}
.cpa-tx{width:100%;border-collapse:collapse;font-size:.75rem;margin-bottom:18px}
.cpa-tx th{background:#1a1a1a;color:#FFD700;padding:7px 8px;text-align:left;font-weight:700;white-space:nowrap}
.cpa-tx td{padding:6px 8px;border-bottom:1px solid #eee;vertical-align:top}
.cpa-tx tr:hover{background:#f9f9f9}.cpa-tx tr.cpr{background:#F0FFF4}
.cpa-ft{margin-top:28px;padding-top:13px;border-top:2px solid #ddd;font-size:.73rem;color:#aaa;text-align:center}
@media print{.cpa-tb{display:none!important}.cpa-body{padding:8px}@page{margin:14mm}}

.es{text-align:center;padding:36px 20px;color:#999}.es .ei{font-size:2rem;margin-bottom:8px}
@media(max-width:600px){.content{padding:10px}.fr{grid-template-columns:1fr}.cpa-body{padding:14px}}
</style>
</head>
<body>

<div id="loading"><div class="spin">⚙️</div><div>Loading...</div></div>

<!-- SCREEN 1: SETUP -->
<div id="screen-setup" class="screen">
 <div class="auth-wrap">
  <div class="auth-box">
   <div class="auth-logo">
     <div class="icon">💳</div>
     <h1>Capital One Payment Tracker</h1>
     <p>First-time setup — choose your data storage</p>
   </div>
   <p style="font-size:.82rem;color:#555;margin-bottom:12px;font-weight:600;">How do you want to store your data?</p>
   <button class="mode-btn" id="btn-online" onclick="selMode('online')">
     <span class="mi">☁️</span>Online — Google Sheets (Recommended)
     <small>Data saved to your own Google Sheet. Access from any phone, iPad, or computer.</small>
   </button>
   <button class="mode-btn" id="btn-local" onclick="selMode('local')">
     <span class="mi">💾</span>Local — This Device Only
     <small>Data stays in this browser. Works offline. No setup needed.</small>
   </button>
   <div id="online-setup" style="display:none;margin-top:14px;">
     <div class="step-box">
       <span class="step-num">1</span><span class="step-title">Create a Google Sheet</span>
       <div class="step-body"><ol>
         <li>Go to <strong>sheets.google.com</strong> → click <strong>"+"</strong></li>
         <li>Name it: <code>Capital One Tracker 2026</code></li>
       </ol></div>
     </div>
     <div class="step-box">
       <span class="step-num">2</span><span class="step-title">Open Script Editor &amp; Paste Code</span>
       <div class="step-body"><ol>
         <li>In your sheet: <strong>Extensions → Apps Script</strong></li>
         <li>Open <code>AppsScript_Backend.js</code> in Notepad → Ctrl+A → Ctrl+C</li>
         <li>In Apps Script: Ctrl+A → Delete → Ctrl+V → Save (Ctrl+S)</li>
       </ol></div>
     </div>
     <div class="step-box">
       <span class="step-num">3</span><span class="step-title">Set Token &amp; Deploy</span>
       <div class="step-body"><ol>
         <li>Change <code>CAP1-HARRY-CHANGE-ME</code> to your own token, write it down</li>
         <li><strong>Deploy → New Deployment → Web App</strong></li>
         <li>Execute as: <strong>Me</strong> · Who has access: <strong>Anyone</strong></li>
         <li>Deploy → Authorize → copy the URL</li>
       </ol></div>
     </div>
     <div class="fg" style="margin-top:8px;">
       <label>Google Apps Script URL *</label>
       <input type="url" id="s-url" placeholder="https://script.google.com/macros/s/.../exec" autocomplete="off">
     </div>
     <div class="fg">
       <label>Your Secret Token *</label>
       <div class="pw">
         <input type="password" id="s-token" placeholder="e.g. CAP1-HARRY-977381" autocomplete="off">
         <button class="pw-tog" onclick="togVis('s-token',this)" tabindex="-1">👁️</button>
       </div>
     </div>
   </div>
   <div id="setup-msg" style="display:none;" class="alert aw"></div>
   <button class="btn btn-red btn-full" onclick="saveSetup()" style="margin-top:12px;">Continue →</button>
  </div>
 </div>
</div>

<!-- SCREEN 2: LOGIN -->
<div id="screen-login" class="screen">
 <div class="auth-wrap">
  <div class="auth-box">
   <div class="auth-logo">
     <div class="icon">🔐</div>
     <h1>Capital One Payment Tracker</h1>
     <p>SQS Card · Multi-Store Expense Tracker</p>
   </div>
   <div class="fg">
     <label>Password</label>
     <div class="pw">
       <input type="password" id="login-pw" placeholder="Enter password"
         onkeydown="if(event.key==='Enter')login()" autocomplete="current-password">
       <button class="pw-tog" onclick="togVis('login-pw',this)" tabindex="-1">👁️</button>
     </div>
     <div class="err" id="login-err">Incorrect password. Please try again.</div>
   </div>
   <button class="btn btn-red btn-full" onclick="login()">Unlock →</button>
   <p style="text-align:center;font-size:.7rem;color:#bbb;margin-top:12px;">Forgot password? Contact Harry Desai</p>
   <div style="margin-top:16px;padding-top:12px;border-top:1px solid #eee;text-align:center;">
     <button class="btn btn-outline btn-sm" onclick="resetSetup()">⚙️ Change Storage Settings</button>
   </div>
  </div>
 </div>
</div>

<!-- SCREEN 3: MAIN APP -->
<div id="screen-app" class="screen">
 <div class="hdr">
   <div class="hdr-top">
     <span class="hdr-title">💳 Capital One Record</span>
     <div class="hdr-acts">
       <span class="sync-badge" id="sync-st"></span>
       <button class="btn btn-gray btn-sm" onclick="openCPA()">📄 CPA</button>
       <button class="btn btn-sm" style="background:#333;color:#FFD700;font-size:.7rem;" onclick="logout()">🔓 Lock</button>
     </div>
   </div>
   <div class="hdr-sub" id="hdr-sub">Loading...</div>
 </div>
 <nav class="nav">
   <button class="active" onclick="swTab('add',this)">➕ Add</button>
   <button onclick="swTab('pending',this)">⏳ Pending</button>
   <button onclick="swTab('records',this)">📋 Records</button>
   <button onclick="swTab('pay',this)">✅ Pay</button>
   <button onclick="swTab('history',this)">🏦 History</button>
   <button onclick="swTab('import',this)">📥 Import</button>
 </nav>
 <div class="content">

  <!-- ADD -->
  <div id="tab-add" class="tab active">
   <div class="card">
    <div class="ct">Add New Charge</div>
    <div id="add-alert"></div>
    <div class="fr">
      <div class="fg"><label>Posted Date *</label><input type="date" id="f-date"></div>
      <div class="fg"><label>Amount ($) *</label><input type="number" id="f-amount" placeholder="0.00" step="0.01" min="0.01" inputmode="decimal"></div>
    </div>
    <div class="fg"><label>Charged By (Vendor) *</label>
      <input type="text" id="f-vendor" placeholder="e.g. Sam's Club, Amazon, SCDOR Dorway"></div>
    <div class="fg"><label>Purpose / Description *</label>
      <input type="text" id="f-purpose" placeholder="e.g. Sales Tax, Cleaning Supply, Milligan Fee Jan"></div>
    <div class="fg"><label>Notes (Order #, reference)</label>
      <input type="text" id="f-notes" placeholder="Order # or extra info"></div>
    <div class="fg">
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
        <input type="checkbox" id="f-split" onchange="togSplit()" style="width:18px;height:18px;">
        Split between multiple stores
      </label>
    </div>
    <div id="single-sec">
      <div class="fg"><label>Assign to Store *</label>
        <select id="f-store"><option value="">-- Select Store --</option></select></div>
    </div>
    <div id="split-sec" style="display:none;">
      <div class="split-box">
        <p style="font-size:.76rem;color:#7A5700;margin-bottom:9px;font-weight:600;">⚠️ Split amounts must equal the total charge.</p>
        <div id="split-rows"></div>
        <button class="btn btn-yellow btn-sm" onclick="addSR()">+ Add Store</button>
        <span id="split-chk" style="font-size:.73rem;color:#888;margin-left:10px;"></span>
      </div>
    </div>
    <div style="margin-top:13px;">
      <button class="btn btn-red btn-full" onclick="addTxn()">➕ Add Transaction</button>
    </div>
   </div>
  </div>

  <!-- PENDING -->
  <div id="tab-pending" class="tab">
    <div id="pend-sum" class="sbar"></div>
    <div id="pend-body"></div>
  </div>

  <!-- RECORDS -->
  <div id="tab-records" class="tab">
   <div class="card" style="padding:11px;">
    <div class="fbar">
      <select id="flt-store" onchange="renderRec()"><option value="">All Stores</option></select>
      <select id="flt-stat" onchange="renderRec()">
        <option value="">All Status</option>
        <option value="PENDING">Pending</option>
        <option value="PAID">Paid</option>
      </select>
      <button class="btn btn-green btn-sm" onclick="exportCSV()">📤 CSV</button>
    </div>
    <div id="rec-cnt" style="font-size:.7rem;color:#888;margin-bottom:8px;"></div>
    <div id="rec-desk" class="tw">
      <table class="rt"><thead><tr>
        <th>Date</th><th>Charged By</th><th>Amount</th><th>Store</th>
        <th>Ops Account</th><th>Purpose</th><th>Notes</th>
        <th>Payoff Date</th><th>Confo #</th><th>Status</th><th></th>
      </tr></thead><tbody id="rec-tbody"></tbody></table>
    </div>
    <div id="rec-mob"></div>
   </div>
  </div>

  <!-- PAY -->
  <div id="tab-pay" class="tab">
    <div class="card" style="background:#FFF9E6;">
      <p style="font-size:.82rem;color:#555;">Select a store, enter the Capital One confirmation number, and mark it paid.</p>
    </div>
    <div id="pay-body"></div>
  </div>

  <!-- HISTORY -->
  <div id="tab-history" class="tab">
    <div id="hist-body"></div>
  </div>

  <!-- IMPORT -->
  <div id="tab-import" class="tab">
   <div class="card">
    <div class="ct">📥 Paste Import</div>
    <p style="font-size:.8rem;color:#555;margin-bottom:9px;">
      Copy from Capital One website, paste below.<br>
      Format (tab or comma): <code style="background:#f5f5f5;padding:1px 5px;border-radius:4px;font-size:.74rem;color:#CC0000;">MM/DD/YYYY &nbsp; Vendor &nbsp; Amount</code>
    </p>
    <textarea id="imp-text" class="ia" placeholder="01/24/2026&#9;Target&#9;46.78&#10;01/29/2026&#9;Dollar General&#9;27.83"></textarea>
    <div style="margin-top:9px;display:flex;gap:8px;flex-wrap:wrap;">
      <button class="btn btn-red" onclick="parseImp()">🔍 Parse</button>
      <button class="btn btn-gray btn-sm" onclick="document.getElementById('imp-text').value='';document.getElementById('imp-prev').innerHTML=''">Clear</button>
    </div>
   </div>
   <div id="imp-prev"></div>
  </div>

 </div>
